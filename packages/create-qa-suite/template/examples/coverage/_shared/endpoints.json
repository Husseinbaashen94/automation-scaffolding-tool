{
  "$schema": "../../schemas/endpoints.schema.json",
  "endpoints": [
    {
      "id": "create-booking",
      "method": "POST",
      "path": "/booking",
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "body": {
          "firstname": "Sally",
          "lastname": "Brown",
          "totalprice": 111,
          "depositpaid": true,
          "bookingdates": {
            "checkin": "2026-01-01",
            "checkout": "2026-01-05"
          },
          "additionalneeds": "Breakfast"
        }
      },
      "response": {
        "type": "object",
        "required": [
          "bookingid",
          "booking"
        ],
        "properties": {
          "bookingid": {
            "type": "number"
          },
          "booking": {
            "type": "object",
            "required": [
              "firstname",
              "lastname",
              "totalprice",
              "depositpaid",
              "bookingdates"
            ],
            "properties": {
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              },
              "totalprice": {
                "type": "number"
              },
              "depositpaid": {
                "type": "boolean"
              },
              "bookingdates": {
                "type": "object",
