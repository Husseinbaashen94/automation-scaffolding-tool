{
  "$schema": "../../schemas/pages.schema.json",
  "pages": [
    {
      "id": "login",
      "path": "/",
      "marker": "login-button",
      "elements": {
        "username": "[data-test=\"username\"]",
        "password": "[data-test=\"password\"]",
        "login-button": "[data-test=\"login-button\"]",
        "error": "[data-test=\"error\"]"
      }
    },
    {
      "id": "inventory",
      "path": "/inventory.html",
      "marker": "list",
      "elements": {
        "list": "[data-test=\"inventory-list\"]",
        "add-backpack": "[data-test=\"add-to-cart-sauce-labs-backpack\"]",
        "remove-backpack": "[data-test=\"remove-sauce-labs-backpack\"]",
        "add-bike-light": "[data-test=\"add-to-cart-sauce-labs-bike-light\"]",
        "cart-badge": "[data-test=\"shopping-cart-badge\"]"
      }
    }
  ]
}
