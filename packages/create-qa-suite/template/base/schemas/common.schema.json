{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Shared definitions for QA suite coverage files",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "elementRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$", "description": "<page>.<element>" },
    "path": { "type": "string", "pattern": "^/" },
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    "values": { "type": "object" },
    "page": {
      "type": "object",
      "required": ["id", "path", "marker", "elements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "path": { "$ref": "#/definitions/path" },
        "marker": { "$ref": "#/definitions/id", "description": "An element that proves the page is shown" },
        "elements": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "step": {
      "oneOf": [
        { "type": "object", "required": ["goto"], "additionalProperties": false, "properties": { "goto": { "$ref": "#/definitions/id" } } },
        { "type": "object", "required": ["fill", "value"], "additionalProperties": false, "properties": { "fill": { "$ref": "#/definitions/elementRef" }, "value": {} } },
        { "type": "object", "required": ["click"], "additionalProperties": false, "properties": { "click": { "$ref": "#/definitions/elementRef" } } },
        { "type": "object", "required": ["select", "value"], "additionalProperties": false, "properties": { "select": { "$ref": "#/definitions/elementRef" }, "value": {} } },
        { "type": "object", "required": ["check"], "additionalProperties": false, "properties": { "check": { "$ref": "#/definitions/elementRef" } } },
        { "type": "object", "required": ["visible"], "additionalProperties": false, "properties": { "visible": { "$ref": "#/definitions/elementRef" } } },
        { "type": "object", "required": ["hidden"], "additionalProperties": false, "properties": { "hidden": { "$ref": "#/definitions/elementRef" } } },
        { "type": "object", "required": ["text", "equals"], "additionalProperties": false, "properties": { "text": { "$ref": "#/definitions/elementRef" }, "equals": {} } },
        { "type": "object", "required": ["value", "equals"], "additionalProperties": false, "properties": { "value": { "$ref": "#/definitions/elementRef" }, "equals": {} } },
        { "type": "object", "required": ["count", "equals"], "additionalProperties": false, "properties": { "count": { "$ref": "#/definitions/elementRef" }, "equals": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "required": ["url"], "additionalProperties": false, "properties": { "url": { "$ref": "#/definitions/id" } } }
      ]
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
    "draft": { "const": true, "description": "Added by create-qa-suite and not filled in yet; reported as to-do (fixme), not run" }
  }
}
