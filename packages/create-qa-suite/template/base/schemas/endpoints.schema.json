{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "endpoints.schema.json",
  "title": "Endpoints of the application under test (coverage/_shared/endpoints.json)",
  "type": "object",
  "required": ["endpoints"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "method", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "method": { "$ref": "common.schema.json#/definitions/method" },
          "path": { "$ref": "common.schema.json#/definitions/path" },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "body": {} }
          },
          "response": { "type": "object", "description": "A JSON Schema the response body must match" }
        }
      }
    }
  }
}
